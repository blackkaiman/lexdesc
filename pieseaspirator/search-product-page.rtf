\
        window.open(searchUrl, "_blank");\
\
        setTimeout(() => \{\
            btn.disabled = false;\
            btn.textContent = "\uc0\u55357 \u56589  Caut\u259  piesa";\
        \}, 800);\
    \});\
\});\
</script>\
